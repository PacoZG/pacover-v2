{
  "name": "pacoder-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install-dependencies": "scripts/install-dependencies.sh",
    "update-minor-deps-versions": "./scripts/update-minor-patch-only.sh",
    "dev": "scripts/run-dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "verify-code-style": "prettier --check 'src/**/*.ts'",
    "fix-code-style": "prettier --write 'src/**/*.ts'",
    "test-for-ci": "npx vitest --watch=false --coverage.enabled --coverage.thresholds.100",
    "coverage": "vitest --coverage --watch=false && open coverage/index.html",
    "test": "vitest",
    "postinstall": "git config --local include.path ../.gitconfig && chmod ug+x ./scripts/git-hooks/*",
    "svg": "svgr -d src/components/icons src/utils/assets/google-cloud.svg"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "globals": "^17.13.0",
    "i18next-resources-to-backend": "^1.2.3",
    "next": "16.3.8",
    "next-i18n-router": "^5.5.8",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@emailjs/browser": "^4.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@next/eslint-plugin-next": "^16.3.8",
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.0.1",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.50.0",
    "react-google-recaptcha": "^3.1.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "react-share": "^5.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
